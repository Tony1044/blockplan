# Copy this file to .env and fill in what you need. Restart Blockplan after changes.

# Where Blockplan listens. 0.0.0.0 lets other computers on your network open it.
HOST=0.0.0.0
PORT=8080

# Where maps are stored (one SQLite file). Back this folder up.
# DATA_DIR=./data

# Optional sign-in. Set both to ask everyone for this username and password.
AUTH_USER=
AUTH_PASSWORD=

# AI helper
#   auto   - Claude first, local model if Claude is not set up or fails (default)
#   claude - Claude only
#   local  - local model only; nothing about your maps leaves this machine
#   off    - no AI helper
AI_MODE=auto

# Claude. Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Only needed if your key is not limited to one workspace. Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-5-5
# Haiku is quicker and cheaper; Opus is the most capable.
# CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=6000

# Local model through Ollama (https://ollama.com). Run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Seconds to wait for an answer before giving up.
AI_TIMEOUT=180
