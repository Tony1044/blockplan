# Copy this file to .env and fill in what you need. Restart Blockplan after changes.

# Where Blockplan listens. 0.0.0.0 lets other computers on your network open it.
HOST=0.0.0.0
PORT=8080

# Where maps are stored (one SQLite file). Back this folder up.
# DATA_DIR=./data

# Optional sign-in. Set both to ask everyone for this username and password.
AUTH_USER=
AUTH_PASSWORD=

# AI helper
#   auto   - try each AI service that is set up below, in AI_ORDER (default)
#   claude, azure, openai, local - use only that one
#   off    - no AI helper
# With local, nothing about your maps leaves this machine.
AI_MODE=auto
AI_ORDER=claude,azure,openai,local

# --- Claude, from Anthropic. Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Only needed if your key is not limited to one workspace. Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-5-5
# Haiku is quicker and cheaper; Opus is the most capable.
# CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=6000

# --- Azure OpenAI (Azure AI Foundry). This is how organisations on Microsoft can use the
# same family of models as Copilot. (Microsoft 365 Copilot's own Chat API is still in
# preview and needs each person to sign in with a Copilot licence, so it isn't supported yet.)
# Endpoint looks like https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The name you gave the model when you deployed it in Azure
AZURE_OPENAI_DEPLOYMENT=

# --- OpenAI, or any service that accepts OpenAI-style requests. Set the address,
# a key, and a model name from that service. For example:
#   OpenAI         https://api.openai.com/v1                                (default)
#   OpenRouter     https://openrouter.ai/api/v1
#   Mistral        https://api.mistral.ai/v1
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq           https://api.groq.com/openai/v1
#   LM Studio      http://localhost:1234/v1      (on this machine; no key needed)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Any chat model the service offers, for example gpt-5.5 on OpenAI
OPENAI_MODEL=
# Optional: the name the page shows for it
OPENAI_NAME=

# --- A model on this machine through Ollama (https://ollama.com). Run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Seconds to wait for an answer before giving up.
AI_TIMEOUT=180

# HTTPS
# Blockplan uses HTTPS from the start. On the first run it makes a self-signed
# certificate in the certs folder, so https:// works straight away (browsers warn
# about it until it's trusted). To use a real certificate, put it in the certs folder
# (see certs/README.txt) and restart: it's used instead of the self-signed one.
#   self-signed - a certificate from the certs folder, or a self-signed one (default)
#   auto        - HTTPS if there's a certificate in the certs folder, otherwise HTTP
#   on          - HTTPS, and don't start without a certificate in the certs folder
#   off         - plain HTTP
HTTPS=self-signed
# Only if your files are somewhere else, or have passwords:
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
# TLS_KEY_PASSWORD=
# TLS_PFX=/path/to/certificate.pfx
TLS_PFX_PASSWORD=
# Extra names for a self-signed certificate, for example: blockplan.local,192.168.1.20
HTTPS_HOSTNAMES=
